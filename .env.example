# ============================================================================
# OpenRabbit Environment Configuration
# ============================================================================
# Copy to .env or run scripts/setup-pi.sh. Never commit .env.

# Server
PORT=3847
HOST=0.0.0.0
OPENRABBIT_BIND_ADDRESS=127.0.0.1
OPENRABBIT_PUBLIC_URL=http://127.0.0.1:3847
OPENRABBIT_ADMIN_TOKEN=
OPENRABBIT_DATA_DIR=./data
OPENRABBIT_MAX_BODY_BYTES=2097152

# Background review queue
OPENRABBIT_ASYNC_WEBHOOKS=true
OPENRABBIT_JOB_CONCURRENCY=1
OPENRABBIT_JOB_MAX_ATTEMPTS=3
OPENRABBIT_RETRY_DELAY_MS=1000

# Container image target: lite | full
OPENRABBIT_DOCKER_TARGET=lite

# Public webhook tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=

# LLM Provider Configuration (Multi-provider BYOK)
# Supported: auto | openai | anthropic | gemini | ollama | heuristic
OPENRABBIT_LLM_PROVIDER=auto
OPENRABBIT_LLM_MODEL=

# OpenAI (or any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Ollama (not recommended on the same Raspberry Pi)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# GitHub Integration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# GitLab Integration
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_API_URL=https://gitlab.com/api/v4

# Bitbucket Integration
BITBUCKET_TOKEN=
BITBUCKET_WEBHOOK_SECRET=
BITBUCKET_API_URL=https://api.bitbucket.org/2.0

# Codeberg / Forgejo / Gitea Integration
FORGEJO_TOKEN=
FORGEJO_WEBHOOK_SECRET=
FORGEJO_WEB_URL=https://codeberg.org
FORGEJO_API_URL=https://codeberg.org/api/v1
