# ============================================================================
# OpenRabbit Environment Configuration
# ============================================================================

# Server Configuration
PORT=3847
HOST=localhost

# LLM Provider Configuration (Multi-provider BYOK)
# Supported: auto | openai | anthropic | gemini | ollama | heuristic
OPENRABBIT_LLM_PROVIDER=auto
OPENRABBIT_LLM_MODEL=

# OpenAI (or any OpenAI-compatible API like Groq, Together, DeepSeek, vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Ollama (Local private LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# GitHub Integration (Webhook Bot & PR Reviewer)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com

# GitLab Integration (Merge Request Bot & Reviewer)
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
GITLAB_API_URL=https://gitlab.com/api/v4
